# Public frontend configuration. Vite exposes VITE_* values to the browser.
VITE_API_BASE_URL=/api
VITE_LANYARD_REST_BASE_URL=https://api.lanyard.rest/v1/users
VITE_LANYARD_SOCKET_URL=wss://api.lanyard.rest/socket
VITE_MAPS_SEARCH_BASE_URL=https://maps.google.com/?q=
VITE_LOCALE=ru-RU
VITE_STORAGE_PREFIX=profile_card

# Build-time metadata used before /api/profile is loaded.
VITE_SITE_TITLE=Profile
VITE_SITE_DESCRIPTION=Digital profile and projects
VITE_SITE_URL=https://profile.example.com
VITE_SITE_NAME=Profile
VITE_SITE_IMAGE_URL=https://profile.example.com/avatar.jpg
VITE_SITE_IMAGE_ALT=Profile avatar
VITE_SITE_IMAGE_TYPE=image/jpeg
VITE_SITE_IMAGE_WIDTH=500
VITE_SITE_IMAGE_HEIGHT=500
VITE_SITE_LANGUAGE=en
VITE_FAVICON_PATH=/favicon.svg

# Terminal branding.
VITE_TERMINAL_PRODUCT_NAME=whoami
VITE_TERMINAL_VERSION=
VITE_TERMINAL_HOST_NAME=profile

# Polling intervals in milliseconds.
VITE_PROFILE_REFRESH_MS=300000
VITE_SERVER_STATUS_REFRESH_MS=15000
VITE_SPOTIFY_REFRESH_MS=5000
VITE_LAST_SEEN_REFRESH_MS=30000
VITE_WEATHER_REFRESH_MS=600000
VITE_LIVE_VISITORS_REFRESH_MS=2500
VITE_GUESTBOOK_REFRESH_MS=6000
