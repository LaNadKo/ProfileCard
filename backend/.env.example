# Localization (ru / en)
PROFILE_LANG=ru

# Profile (Default / Russian)
OWNER_NAME=Your Name
OWNER_NICKNAME=Your Nickname
OWNER_ALIAS=Your Alias
OWNER_HANDLE=@your_handle
OWNER_ROLE=Your Role
OWNER_ROLE_EN=Your Role (English)
OWNER_BIO=Short profile description
OWNER_BIO_EN=Short profile description (English)
OWNER_LOCATION=Your City
OWNER_LOCATION_EN=Your City (English)
OWNER_TIMEZONE=UTC
OWNER_TIMEZONE_OFFSET=0
OWNER_CANONICAL_URL=https://profile.example.com
OWNER_AVATAR_PATH=/avatar.jpg
OWNER_VIDEO_PATH=/video_bg.mp4
OWNER_VIDEO_POSTER_PATH=/poster.jpg

# Weather
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
WEATHER_LATITUDE=0
WEATHER_LONGITUDE=0
WEATHER_TIMEZONE=UTC
WEATHER_LOCATION_LABEL=Your City

# Social links
TELEGRAM_URL=https://t.me/your_handle
TELEGRAM_HANDLE=@your_handle
TELEGRAM_LABEL=Primary contact
DISCORD_URL=https://discord.com/users/your_user_id
DISCORD_HANDLE=your_discord_username
DISCORD_USER_ID=your_user_id
DISCORD_LABEL=Voice and chat
STEAM_URL=https://steamcommunity.com/id/your_id/
STEAM_DISPLAY_NAME=Your Steam name
STEAM_LABEL=Gaming profile
GITHUB_URL=https://github.com/your_username
GITHUB_DISPLAY_NAME=your_username
GITHUB_USERNAME=your_username
GITHUB_TOKEN=
GITHUB_LABEL=Repositories
GITHUB_HIDE_PRIVATE=true
TIKTOK_URL=https://www.tiktok.com/@your_handle
TIKTOK_HANDLE=@your_handle
TIKTOK_LABEL=Content
SPOTIFY_PROFILE_URL=https://open.spotify.com/user/your_user_id
SPOTIFY_DISPLAY_NAME=Your Spotify name
SPOTIFY_LABEL=Music

# Integrations
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
SPOTIFY_TOKEN_URL=https://accounts.spotify.com/api/token
SPOTIFY_CURRENTLY_PLAYING_URL=https://api.spotify.com/v1/me/player/currently-playing
LANYARD_REST_BASE_URL=https://api.lanyard.rest/v1/users
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_USER_AGENT=ProfileCard
OUTBOUND_USER_AGENT=ProfileCard

# Projects: relative paths are resolved from the backend directory.
PROJECTS_FILE=projects.example.json
PROJECTS_JSON=

# Guestbook, analytics and privacy
GUESTBOOK_ALLOWED_REACTIONS=🔥,⚡,💀,❤️
GUESTBOOK_RESERVED_NAMES=your_name,your_alias,admin,administrator,root,owner
GUESTBOOK_MAX_NAME_LENGTH=50
GUESTBOOK_MAX_MESSAGE_LENGTH=300
EXCLUDED_IPS=
IP_HASH_SECRET=
IP_HASH_SECRET_FILE=.ip_hash_secret
ACTIVE_VISITOR_TTL_SECONDS=8
VISIT_SESSION_SECONDS=1800
SPOTIFY_LAST_PLAYED_TTL_SECONDS=60
LAST_SEEN_FALLBACK_SECONDS=3600
GITHUB_CACHE_TTL_SECONDS=600
MAX_REQUEST_BYTES=16384

# HTTP server
BIND_HOST=0.0.0.0
PORT=8095
DB_PATH=data.db
SYSTEM_DISK_PATH=/
CORS_ALLOWED_ORIGINS=https://profile.example.com
